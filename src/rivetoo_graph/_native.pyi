from typing import Protocol

class NativeGraph:
    @property
    def label(self) -> str: ...

class NativeActionBindings:
    def __init__(self, node_count: int) -> None: ...

class ExperimentalCallbackHost(Protocol):
    def skipped_nodes(self) -> list[int]: ...
    def resolve_conditions(
        self,
        requests: list[tuple[int, int]],
    ) -> list[tuple[int, bool | None]]: ...
    def raise_failures(self) -> None: ...
    def apply_events(self, events: list[tuple[int, int, bool | None]]) -> None: ...
    def run_leaf(self, node: int) -> None: ...
    def stop_requested(self) -> bool: ...
    def request_stop(self) -> None: ...
    def require_running(self) -> None: ...

def dag_cycle(
    node_count: int,
    arcs: list[tuple[int, int]],
) -> list[int] | None: ...
def resolve_capability_bindings(
    component_outputs: list[list[int]],
    requirement_count: int,
    any_requirements: list[tuple[int, int, int]],
    exact_requirements: list[tuple[int, int, int, int]],
    selections: list[tuple[int, int]],
) -> list[tuple[int, int, int]]: ...

class NativeDeclarationCompilation:
    @property
    def graph(self) -> NativeCompiledExecutionGraph: ...
    def declaration_nodes(self) -> list[int]: ...
    def declaration_conditions(self) -> list[int]: ...
    def node_step_ids(self) -> list[list[int]]: ...
    def node_labels(self) -> list[str]: ...
    def node_graphs(self) -> list[int]: ...
    def node_child_graphs(self) -> list[int | None]: ...
    def source_steps(self) -> list[object | None]: ...
    def actions(self) -> list[object | None]: ...
    def native_actions(self) -> NativeActionBindings: ...
    def graph_labels(self) -> list[str]: ...
    def graph_label_paths(self) -> list[list[str]]: ...
    def graph_owners(self) -> list[int | None]: ...
    def graph_local_nodes(self) -> list[list[int]]: ...
    def source_graphs(self) -> list[object]: ...
    def predicates(self) -> list[object]: ...
    def condition_reads(self) -> list[list[int]]: ...

def compile_declaration(
    source_graph: object,
    root_label: str,
    root_label_path: list[str] = ...,
    id_prefix: list[int] = ...,
) -> NativeDeclarationCompilation: ...
def _native_process_graph(
    label: str,
    processes: list[tuple[str, str, list[str], str, dict[str, str]]],
    arcs: list[tuple[int, int]],
) -> NativeGraph: ...
def _experimental_run_tokio_callbacks(
    graph: NativeCompiledExecutionGraph,
    host: ExperimentalCallbackHost,
    concurrency: int,
) -> None: ...

class NativeCompiledExecutionGraph:
    def __init__(
        self,
        node_graphs: list[int],
        composite_child_graphs: list[tuple[int, int]],
        graph_owners: list[int | None],
        prerequisites: list[list[tuple[int, int | None]]],
        when_conditions: list[int | None],
        condition_reads: list[list[int]],
        capability_bindings: list[tuple[int, int]],
    ) -> None: ...
    def roots(self) -> list[int]: ...
    def children(self, node: int) -> list[int]: ...
    def dependents(self, node: int) -> list[int]: ...
    def all_prerequisites(self) -> list[list[tuple[int, int | None]]]: ...
    def when_conditions(self) -> list[int | None]: ...
    def topological_order(self) -> list[int]: ...
    def session(self, initially_skipped: list[int]) -> NativeExecutionSession: ...
    def mixed_session(
        self,
        initially_skipped: list[int],
        native_actions: NativeActionBindings,
        native_contexts: list[tuple[int, str | None]],
        workers: int,
    ) -> NativeMixedExecutionSession: ...

class NativeExecutionBatch:
    def parts(
        self,
    ) -> tuple[
        list[int],
        list[tuple[int, int]],
        list[tuple[int, int, bool | None]],
        bool,
    ]: ...

class NativeExecutionSession:
    def start(self, max_actions: int) -> NativeExecutionBatch: ...
    def advance(
        self,
        completed: list[tuple[int, bool]],
        conditions: list[tuple[int, bool | None]],
        skipped: list[int],
        max_actions: int,
    ) -> NativeExecutionBatch: ...

class NativeMixedExecutionBatch:
    def parts(
        self,
    ) -> tuple[
        list[int],
        list[tuple[int, int]],
        list[tuple[int, int, bool | None]],
        bool,
        int,
        list[tuple[int, str]],
    ]: ...

class NativeMixedExecutionSession:
    def start(self, capacity: int) -> NativeMixedExecutionBatch: ...
    def advance(
        self,
        completed: list[tuple[int, bool]],
        conditions: list[tuple[int, bool | None]],
        skipped: list[int],
        available: int,
    ) -> NativeMixedExecutionBatch: ...
    def wait_native(self) -> None: ...
