from typing import ClassVar, Protocol, Self

class NativeSchedulerHost(Protocol):
    def is_skipped(self, node: int) -> bool: ...
    def evaluate_condition(self, node: int, condition: int) -> bool: ...
    def record_condition(self, node: int, value: bool) -> None: ...
    def record_condition_skip(self, node: int) -> None: ...
    def enter_composite(self, node: int) -> None: ...
    def complete_composite(self, node: int) -> None: ...
    def run_leaf(self, node: int) -> None: ...
    def stop_requested(self) -> bool: ...
    def request_stop(self) -> None: ...
    def require_running(self) -> None: ...

class NativeNodeKind:
    Leaf: ClassVar[Self]
    Composite: ClassVar[Self]

class NativeCompiledExecutionGraph:
    def __init__(
        self,
        kinds: list[NativeNodeKind],
        owners: list[int | None],
        prerequisites: list[list[tuple[int, int | None]]],
        when_conditions: list[int | None],
        condition_reads: list[list[int]],
        capability_bindings: list[tuple[int, int]],
    ) -> None: ...
    def roots(self) -> list[int]: ...
    def children(self, node: int) -> list[int]: ...
    def dependents(self, node: int) -> list[int]: ...
    def all_prerequisites(self) -> list[list[tuple[int, int | None]]]: ...
    def topological_order(self) -> list[int]: ...
    def run_serial(self, host: NativeSchedulerHost) -> None: ...
    def run_threaded(self, host: NativeSchedulerHost, workers: int) -> None: ...
